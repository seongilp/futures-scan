:root {
  --bg: #f3f1eb;
  --bg-dot: #dedbd0;
  --card: #fbfaf7;
  --card-alt: #f7f5ef;
  --ink: #14130f;
  --ink-soft: #6b6860;
  --ink-faint: #9a978c;
  --line: #d9d5cc;
  --line-soft: #e8e5dc;
  --green: #2c7a4b;
  --green-soft: rgba(44, 122, 75, 0.16);
  --red: #bf2f38;
  --red-soft: rgba(191, 47, 56, 0.16);
  --gray: #8f8c80;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background-color: var(--bg);
  background-image: radial-gradient(var(--bg-dot) 1px, transparent 1px);
  background-size: 12px 12px;
  color: var(--ink);
  font-family: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); }
a:hover { border-bottom-color: var(--ink); }
.wrap { max-width: 1680px; margin: 0 auto; padding: 14px 18px 46px; }

/* ---------- primitives ---------- */
.pixel { font-family: 'Silkscreen', 'IBM Plex Mono', monospace; letter-spacing: 0.01em; }
.label {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 9px;
  color: var(--ink-faint);
  white-space: nowrap;
}
.label-ink { color: var(--ink-soft); }
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 10px 12px;
  position: relative;
}
.card.flush { padding: 0; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 2px 8px;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--card);
  color: var(--ink-soft);
  white-space: nowrap;
}
.chip b { font-weight: 600; color: var(--ink); letter-spacing: 0.06em; }
.chip.live { color: var(--green); border-color: rgba(44,122,75,0.45); background: var(--green-soft); }
.chip.accent { border-color: var(--red); color: var(--red); }
.chip.solid { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; display: inline-block; }
.pos { color: var(--green); }
.neg { color: var(--red); }
.neu { color: var(--gray); }
.muted { color: var(--ink-faint); }

/* ---------- header ---------- */
.header {
  display: flex; align-items: center; justify-content: space-between;
  border: 1px solid var(--line); border-radius: 3px; background: var(--card);
  padding: 8px 12px; margin-bottom: 10px; gap: 10px; flex-wrap: wrap;
}
.header .brand { display: flex; align-items: center; gap: 10px; }
.header .logo {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1px solid var(--line); background: var(--card-alt);
  display: flex; align-items: center; justify-content: center; font-size: 13px;
}
.header .title { font-size: 14px; letter-spacing: 0.06em; }
.header .title .accent { color: var(--red); }
.header .meta-right { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

/* ---------- section frame ---------- */
.section {
  border: 1px solid var(--line); border-radius: 3px; background: var(--card);
  margin-top: 10px; overflow: hidden;
}
.section-head {
  display: flex; align-items: baseline; justify-content: space-between; gap: 10px;
  padding: 8px 12px; border-bottom: 1px solid var(--line-soft); flex-wrap: wrap;
}
.section-head h2 {
  margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.02em;
  display: flex; align-items: center; gap: 7px;
}
.section-head h2 .bullet { width: 5px; height: 5px; border-radius: 50%; background: var(--red); }
.section-head h2 .sub { color: var(--ink-faint); font-weight: 400; }
.section-head .hint {
  color: var(--ink-faint); font-size: 9px; letter-spacing: 0.1em; text-transform: lowercase;
}
.section-body { display: grid; grid-template-columns: 196px 1fr; }
.section-body.rev { grid-template-columns: 1fr 196px; }
.section-body > .pane { padding: 10px 12px; min-width: 0; }
.section-body > .stat-col { border-right: 1px solid var(--line-soft); }
.section-body.rev > .stat-col { border-right: none; border-left: 1px solid var(--line-soft); }

/* ---------- dotted-leader stat column ---------- */
.stat-col { padding: 10px 12px; display: flex; flex-direction: column; }
.stat-col .col-title {
  font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--ink-faint); margin-bottom: 7px;
}
.srow {
  display: flex; align-items: baseline; gap: 4px;
  font-size: 10.5px; line-height: 1.85; color: var(--ink-soft);
}
.srow .k { text-transform: lowercase; letter-spacing: 0.03em; white-space: nowrap; }
.srow .lead {
  flex: 1; border-bottom: 1px dotted var(--line); transform: translateY(-3px); min-width: 8px;
}
.srow .v { color: var(--ink); font-weight: 500; white-space: nowrap; }
.srow.rule { border-top: 1px solid var(--line-soft); margin-top: 6px; padding-top: 5px; }
.stat-note {
  margin-top: auto; padding-top: 12px; font-size: 9px; line-height: 1.6;
  color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.06em;
}

/* ---------- hero ---------- */
.hero { display: grid; grid-template-columns: 1.45fr 1fr; gap: 10px; }
.hero-left { display: grid; grid-template-columns: 196px 1fr; }
.hero-main { padding: 10px 14px; min-width: 0; }
.hero-num { font-size: 58px; line-height: 1.05; letter-spacing: -0.01em; }
.hero-unit { font-size: 20px; color: var(--ink-faint); }
.chiprow { display: flex; gap: 5px; flex-wrap: wrap; margin: 8px 0; }
.tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 10px; }
.tile {
  border: 1px solid var(--line-soft); border-radius: 2px; padding: 6px 8px;
  background: var(--card-alt);
}
.tile.sel { border-color: var(--ink); background: var(--card); box-shadow: inset 0 0 0 1px var(--line-soft); }
.tile .sym { font-size: 10.5px; font-weight: 600; letter-spacing: 0.02em; }
.tile .val { font-size: 13px; margin-top: 1px; }
.tile .meta { font-size: 8.5px; color: var(--ink-faint); letter-spacing: 0.05em; }
.hero-foot {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  margin-top: 10px; font-size: 9px; color: var(--ink-faint); letter-spacing: 0.08em;
}

/* ---------- top wins ---------- */
.wins { display: flex; flex-direction: column; height: 100%; }
.wins-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 12px; border-bottom: 1px solid var(--line-soft);
}
.wins-body { padding: 10px 12px; display: grid; grid-template-columns: 1fr 1.15fr; gap: 10px; }
.win-mult { font-size: 40px; line-height: 1; }
.win-plus { font-size: 14px; color: var(--ink-faint); vertical-align: super; }
.win-flow { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 11px; }
.win-flow .arrow { color: var(--ink-faint); }
.pager { display: flex; gap: 4px; justify-content: center; margin-top: 8px; }
.pager i { width: 14px; height: 3px; background: var(--line); border-radius: 2px; cursor: pointer; }
.pager i.on { background: var(--ink); }

/* ---------- viz ---------- */
svg { display: block; width: 100%; height: auto; }
.axis-txt { font-size: 8px; fill: var(--ink-faint); letter-spacing: 0.08em; }
.boxlabel { font-size: 8px; letter-spacing: 0.1em; }

/* ---------- table ---------- */
table { border-collapse: collapse; width: 100%; font-size: 11px; }
th, td { text-align: right; padding: 4px 10px; border-bottom: 1px solid var(--line-soft); white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
th {
  text-transform: uppercase; letter-spacing: 0.1em; font-size: 8.5px;
  color: var(--ink-faint); font-weight: 500; border-bottom: 1px solid var(--line);
}
tbody tr:hover td { background: var(--card-alt); }
.scroll-x { overflow-x: auto; }

/* ---------- footer ---------- */
.statusbar {
  margin-top: 10px;
  padding: 6px 12px; border: 1px solid var(--line); border-radius: 3px;
  background: var(--card);
  font-size: 8.5px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--ink-faint);
  display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap;
}
.statusbar b { color: var(--ink-soft); font-weight: 500; }

/* ---------- controls ---------- */
button.ctrl {
  font-family: inherit; font-size: 9px; text-transform: uppercase; letter-spacing: 0.1em;
  background: var(--card); border: 1px solid var(--line); border-radius: 2px;
  padding: 4px 9px; cursor: pointer; color: var(--ink-soft);
}
button.ctrl:hover { background: var(--card-alt); color: var(--ink); }
button.ctrl.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

/* ---------- progress ---------- */
.bar-track { height: 6px; background: var(--line-soft); border-radius: 1px; overflow: hidden; margin-top: 3px; }
.bar-fill { height: 100%; background: var(--ink); }

@media (max-width: 1400px) {
  .hero { grid-template-columns: 1fr; }
}
@media (max-width: 1100px) {
  .section-body, .section-body.rev, .hero-left { grid-template-columns: 1fr; }
  .section-body > .stat-col, .section-body.rev > .stat-col { border: none; border-bottom: 1px solid var(--line-soft); }
  .wins-body { grid-template-columns: 1fr; }
  .hero-num { font-size: 44px; }
}
