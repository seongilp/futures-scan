:root {
  --bg: #f4f2ec;
  --bg-dot: #e3e0d5;
  --card: #fbfaf6;
  --ink: #1c1b18;
  --ink-soft: #5a5850;
  --line: #d8d5c8;
  --green: #2f7d4f;
  --red: #c8323c;
  --gray: #8a8778;
}
* { box-sizing: border-box; }
html, body {
  margin: 0;
  padding: 0;
  background-color: var(--bg);
  background-image: radial-gradient(var(--bg-dot) 1px, transparent 1px);
  background-size: 16px 16px;
  color: var(--ink);
  font-family: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  font-size: 13px;
  line-height: 1.5;
}
a { color: inherit; }
.wrap { max-width: 1400px; margin: 0 auto; padding: 16px; }
.label {
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 10px;
  color: var(--ink-soft);
}
.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 14px 16px;
}
.big-number {
  font-weight: 700;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--card);
}
.chip.live { color: var(--green); border-color: var(--green); }
.dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; display: inline-block; }
.pos { color: var(--green); }
.neg { color: var(--red); }
.neu { color: var(--gray); }
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--card);
  padding: 10px 16px;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 10px;
}
.header .brand { display: flex; align-items: center; gap: 10px; }
.header .logo {
  width: 30px; height: 30px; border-radius: 50%;
  border: 1px solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
}
.header .meta-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.section-title {
  display: flex; align-items: center; justify-content: space-between;
  margin: 22px 0 8px;
  flex-wrap: wrap; gap: 6px;
}
.section-title h2 {
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin: 0;
}
.section-title .hint { color: var(--ink-soft); font-size: 10px; letter-spacing: 0.08em; }
.grid { display: grid; gap: 12px; }
.grid.cols-2 { grid-template-columns: 1fr 1fr; }
.grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
.grid.cols-4 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 900px) {
  .grid.cols-2, .grid.cols-3, .grid.cols-4 { grid-template-columns: 1fr; }
}
table { border-collapse: collapse; width: 100%; font-size: 12px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); }
th { text-transform: uppercase; letter-spacing: 0.08em; font-size: 10px; color: var(--ink-soft); }
tr:hover td { background: rgba(0,0,0,0.02); }
.footer {
  margin-top: 20px;
  padding: 8px 16px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--card);
  font-size: 10px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink-soft);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px;
}
.mono-xl { font-size: 42px; }
.scroll-x { overflow-x: auto; }
button.ctrl {
  font-family: inherit; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em;
  background: var(--card); border: 1px solid var(--line); border-radius: 4px;
  padding: 6px 10px; cursor: pointer; color: var(--ink);
}
button.ctrl:hover { background: var(--bg); }
button.ctrl.active { background: var(--ink); color: var(--bg); }
