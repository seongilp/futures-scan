<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>futures-scan · {{ exchange|upper }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<style>
{% include "_theme.css.j2" %}
.graph-body { display: grid; grid-template-columns: 178px 1fr 186px; }
.graph-body > .side { padding: 10px 12px; min-width: 0; }
.graph-body > .side.l { border-right: 1px solid var(--line-soft); display: flex; flex-direction: column; }
.graph-body > .side.r { border-left: 1px solid var(--line-soft); }
.legend-row { display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--ink-soft); line-height: 1.8; }
.legend-row .sw { width: 8px; height: 8px; border-radius: 50%; flex: none; }
.mini-hist { display: flex; align-items: flex-end; gap: 2px; height: 54px; margin-top: 6px; }
.mini-hist .bar { flex: 1; background: var(--gray); border-radius: 1px 1px 0 0; min-height: 2px; }
.mini-hist .bar.pos { background: var(--green); }
.mini-hist .bar.neg { background: var(--red); }
.bigstat { display: flex; align-items: baseline; justify-content: space-between; padding: 5px 0; border-bottom: 1px dotted var(--line); }
.bigstat .k { font-size: 9px; letter-spacing: 0.11em; text-transform: uppercase; color: var(--ink-faint); }
.bigstat .v { font-size: 15px; }
@media (max-width: 1100px) { .graph-body { grid-template-columns: 1fr; } .graph-body > .side.l, .graph-body > .side.r { border: none; border-bottom: 1px solid var(--line-soft); } }
</style>
</head>
<body>
<div class="wrap">

  {# ------------------------------------------------------------------ header #}
  <div class="header">
    <div class="brand">
      <div class="logo">◆</div>
      <div>
        <div class="label">FUTURES-SCAN · LIVE ON {{ exchange|upper }} · {{ timeframe }}</div>
        <div class="title pixel">FUTURES-SCAN · <span class="accent">{{ exchange|upper }}</span></div>
      </div>
    </div>
    <div class="meta-right">
      <span class="chip live"><span class="dot"></span> LIVE · {{ timeframe|upper }}</span>
      <span class="chip">ROUND <b>#{{ scan_round }}</b></span>
      <span class="chip" id="utc-clock">{{ generated_at_utc }} UTC</span>
    </div>
  </div>

  {# -------------------------------------------------------------------- hero #}
  <div class="hero">
    <div class="card flush">
      <div class="hero-left">
        <div class="stat-col">
          <div class="col-title">session ledger</div>
          {% for r in hero_rows %}
          <div class="srow"><span class="k">{{ r.label }}</span><span class="lead"></span><span class="v {{ r.tone }}">{{ r.value }}</span></div>
          {% endfor %}
          <div class="stat-note">rsi(14) &lt; 30 and volume &ge; 3&times; the 20-bar average — the gate is the whole edge</div>
        </div>
        <div class="hero-main">
          <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
            <span class="label">FUTURES-SCAN · REALISED PNL</span>
            <span class="chip accent">RSI MEAN-REVERT</span>
            <span class="chip">{{ hits|length }} HITS</span>
          </div>
          <div class="hero-num pixel {{ 'pos' if overall.total_pnl_usdt >= 0 else 'neg' }}" style="margin-top:6px;">
            {{ '%+.2f'|format(overall.total_pnl_usdt) }}<span class="hero-unit"> USDT</span>
          </div>
          <div class="chiprow">
            <span class="chip">trades <b>{{ overall.total_trades }}</b></span>
            <span class="chip">win rate <b>{{ '%.1f'|format(overall.win_rate_pct) }}%</b></span>
            <span class="chip">sharpe <b>{{ '%.2f'|format(sharpe) }}</b></span>
            <span class="chip">mdd <b>{{ '%.2f'|format(overall.max_drawdown_usdt) }}</b></span>
            <span class="chip">edge <b class="{{ 'pos' if edge_pp >= 0 else 'neg' }}">{{ '%+.1f'|format(edge_pp) }}pp</b></span>
          </div>
          {% if top_symbols %}
          <div class="tiles">
            {% for t in top_symbols %}
            <div class="tile {{ 'sel' if loop.first }}">
              <div class="sym">{{ t.short }}</div>
              <div class="val pixel {{ 'pos' if t.total_pnl_usdt >= 0 else 'neg' }}">{{ '%+.2f'|format(t.total_pnl_usdt) }}</div>
              <div class="meta">{{ t.total_trades }} tr · {{ t.win_rate_pct }}% wr</div>
            </div>
            {% endfor %}
          </div>
          {% else %}
          <div class="muted" style="margin-top:10px;">no closed trades in this window</div>
          {% endif %}
          <div class="hero-foot">
            <span>anon · {{ exchange }} · {{ timeframe }} · notional 1,000 usdt / trade</span>
            <span class="chip live"><span class="dot"></span> LIVE · CACHED</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card flush">
      <div class="wins">
        <div class="wins-head">
          <span class="label">★ TOP WINS · {{ best_trade.short if best_trade else '—' }} · {{ exchange|upper }}</span>
          <span class="label" id="wins-pager">1 / {{ top_wins|length }}</span>
        </div>
        {% if top_wins %}
        <div class="wins-body">
          <div>
            <div class="win-mult pixel pos"><span id="win-mult">&times;{{ '%.3f'|format(best_trade.multiple) }}</span><span class="win-plus" id="win-plus">+{{ '%.2f'|format(best_trade.pnl_pct) }}%</span></div>
            <div class="label" id="win-meta" style="margin-top:6px;">{{ best_trade.entry_time_short }} · {{ best_trade.short }} · {{ best_trade.exit_reason|upper }} · {{ best_trade.bars_held }} BARS</div>
            <div class="win-flow">
              <div>
                <div class="label">ENTRY</div>
                <div class="pixel" id="win-entry">{{ '%.6g'|format(best_trade.entry_price) }}</div>
              </div>
              <div class="arrow">&rarr;</div>
              <div>
                <div class="label">EXIT</div>
                <div class="pixel pos" id="win-exit">{{ '%.6g'|format(best_trade.exit_price) }}</div>
              </div>
            </div>
            <div style="margin-top:8px;" class="{{ 'pos' if best_trade.pnl_usdt >= 0 else 'neg' }}" id="win-pnl">{{ '%+.2f'|format(best_trade.pnl_usdt) }} USDT</div>
          </div>
          <div>
            <div class="label" style="text-align:right;">CUMULATIVE PNL · {{ overall.total_trades }} FILLS</div>
            <svg id="pnl-curve" viewBox="0 0 320 132" preserveAspectRatio="none" style="height:132px;"></svg>
            <div class="pager" id="pager-dots"></div>
          </div>
        </div>
        {% else %}
        <div class="pane muted" style="padding:12px;">no closed trades yet</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# --------------------------------------------------------- probability lattice #}
  <div class="section">
    <div class="section-head">
      <h2><span class="bullet"></span>Probability Lattice <span class="sub">· {{ overall.total_trades }} trades, one board</span></h2>
      <span class="hint">every trade = one ball · 7 volatility gates · the scan gate tilts the board</span>
    </div>
    <div class="section-body">
      <div class="stat-col">
        <div class="col-title">live convergence</div>
        {% for r in lattice_rows %}
        <div class="srow"><span class="k">{{ r.label }}</span><span class="lead"></span><span class="v {{ r.tone }}">{{ r.value }}</span></div>
        {% endfor %}
        <div class="stat-note">law of large numbers — a {{ '%.1f'|format(overall.win_rate_pct) }}% gate only needs repetition, not conviction</div>
      </div>
      <div class="pane">
        {% if trades %}
        <div style="position:relative;">
          <canvas id="lattice" style="width:100%; display:block;"></canvas>
        </div>
        {% else %}
        <div class="muted">no trades to drop</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ------------------------------------------------------------- tail ridge #}
  <div class="section">
    <div class="section-head">
      <h2><span class="bullet"></span>Tail Probability Ridge <span class="sub">· strike landscape</span></h2>
      <span class="hint">every ridge = one symbol · strike = take-profit · only the tail pays</span>
    </div>
    <div class="section-body">
      <div class="stat-col">
        <div class="col-title">tail scanner</div>
        {% for r in ridge_rows %}
        <div class="srow"><span class="k">{{ r.label }}</span><span class="lead"></span><span class="v {{ r.tone }}">{{ r.value }}</span></div>
        {% endfor %}
        <div class="stat-note">pennies into the body — the strike only breaks {{ '%.1f'|format(tail_mass_pct) }}% of the time</div>
      </div>
      <div class="pane">
        {% if trades_by_symbol_pct %}
        <svg id="ridge" viewBox="0 0 1080 420"></svg>
        {% else %}
        <div class="muted">no closed trades yet</div>
        {% endif %}
      </div>
    </div>
  </div>

  {# ------------------------------------------------------- relationship graph #}
  <div class="section">
    <div class="section-head">
      <h2><span class="bullet"></span>Relationship Graph <span class="sub">· correlation simulation</span></h2>
      <span class="hint" id="graph-counters">nodes {{ nodes|length }} · edges {{ edges|length }} · signal {{ '%.1f'|format(signal_pct) }}% · iter 0</span>
    </div>
    <div class="graph-body">
      <div class="side l">
        <div class="col-title">node class</div>
        <div class="legend-row"><span class="sw" style="background:#bf2f38"></span> bear signal</div>
        <div class="legend-row"><span class="sw" style="background:#2c7a4b"></span> bull signal</div>
        <div class="legend-row"><span class="sw" style="background:#14130f"></span> cluster hub</div>
        <div class="legend-row"><span class="sw" style="background:#8f8c80"></span> catalyst</div>
        <div class="legend-row"><span class="sw" style="background:transparent;border-bottom:2px dashed #14130f;border-radius:0;height:0"></span> median path</div>
        <div style="margin-top:12px;">
          {% for r in graph_rows %}
          <div class="srow"><span class="k">{{ r.label }}</span><span class="lead"></span><span class="v {{ r.tone }}">{{ r.value }}</span></div>
          {% endfor %}
          <div class="srow"><span class="k">iter / sec</span><span class="lead"></span><span class="v" id="iter-sec">—</span></div>
          <div class="label" style="margin-top:8px;">convergence <span id="conv-pct">0%</span></div>
          <div class="bar-track"><div class="bar-fill" id="conv-bar" style="width:0%"></div></div>
          <div class="srow rule"><span class="k">predicted</span><span class="lead"></span><span class="v {{ 'pos' if predicted_dir == 'UP' else 'neg' }}">{{ '▲ UP' if predicted_dir == 'UP' else '▼ DOWN' }}</span></div>
          <div class="srow"><span class="k">median fair</span><span class="lead"></span><span class="v">{{ '%.6g'|format(median_fair) if median_fair is not none else '—' }}</span></div>
        </div>
      </div>
      <div class="side" style="padding:6px;">
        {% if nodes %}
        <svg id="graph" viewBox="0 0 960 470"></svg>
        {% else %}
        <div class="muted" style="padding:10px;">not enough cached candles to build a graph</div>
        {% endif %}
      </div>
      <div class="side r">
        <div class="bigstat"><span class="k">P(UP)</span><span class="v pixel pos">{{ '%.2f'|format(p_up/100) }}</span></div>
        <div class="bigstat"><span class="k">P(DOWN)</span><span class="v pixel neg">{{ '%.2f'|format(p_down/100) }}</span></div>
        <div class="bigstat"><span class="k">edge vs gate</span><span class="v pixel {{ 'pos' if edge_pp >= 0 else 'neg' }}">{{ '%+.1f'|format(edge_pp) }}</span></div>
        <div class="bigstat"><span class="k">confidence</span><span class="v pixel">{{ '%.1f'|format(confidence_pct) }}%</span></div>
        <div class="label" style="margin-top:12px;">24H CHANGE DISTRIBUTION</div>
        {% if change_24h_list %}
        <div class="mini-hist" id="mini-hist"></div>
        {% else %}
        <div class="muted">no 24h data</div>
        {% endif %}
        <div class="stat-note" style="padding-top:10px;">p(up) = share of scan hits whose latest whale-momentum is positive</div>
      </div>
    </div>
  </div>

  {# ---------------------------------------------------------------- scan hits #}
  <div class="section">
    <div class="section-head">
      <h2><span class="bullet"></span>Scan Hits <span class="sub">· {{ hits|length }} symbols</span></h2>
      <span class="hint">rsi(14) &lt; 30 and volume &ge; 3&times; the 20-bar average</span>
    </div>
    <div class="scroll-x" style="padding: 4px 12px 10px;">
      <table>
        <thead><tr><th>symbol</th><th>rsi</th><th>vol&times;</th><th>close</th><th>24h%</th><th>trades</th><th>pnl %</th><th>replay</th></tr></thead>
        <tbody>
          {% for h in hits %}
          {% set link = chart_links[loop.index0] %}
          {% set sym_trades = trades_by_symbol_pct.get(h.symbol, []) %}
          <tr>
            <td><a href="{{ link.path }}">{{ h.symbol }}</a></td>
            <td>{{ '%.1f'|format(h.rsi) }}</td>
            <td>{{ '%.2f'|format(h.vol_ratio) }}</td>
            <td>{{ '%.6g'|format(h.close) }}</td>
            <td class="{{ 'pos' if h.change_24h_pct is not none and h.change_24h_pct >= 0 else 'neg' }}">{{ '%+.2f'|format(h.change_24h_pct) if h.change_24h_pct is not none else 'n/a' }}</td>
            <td>{{ sym_trades|length }}</td>
            <td class="{{ 'pos' if sym_trades and (sym_trades|sum) >= 0 else 'neg' }}">{{ '%+.2f'|format(sym_trades|sum) if sym_trades else '—' }}%</td>
            <td><a href="{{ link.replay }}">replay</a></td>
          </tr>
          {% else %}
          <tr><td colspan="8" class="muted">no scan hits this round</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="statusbar">
    <span><span class="dot pos"></span> AGENT ONLINE · MODEL RSI-VOLSPIKE-V1 · TRADER ANON · <b>{{ overall.total_trades }} FILLS</b></span>
    <span>BACKTEST {{ symbols_count }} SYMBOLS · SCAN {{ scan_seconds }}S · TF {{ timeframe|upper }} · LATENCY <b>{{ ((scan_seconds*1000/symbols_count)|round(1)) if symbols_count else 0 }} MS</b></span>
    <span>STACK <b>FUTURES-SCAN-CORE</b> · {{ generated_date }}</span>
  </div>
</div>

<script type="application/json" id="d-curve">{{ pnl_curve|tojson }}</script>
<script type="application/json" id="d-trades">{{ trades|tojson }}</script>
<script type="application/json" id="d-wins">{{ top_wins|tojson }}</script>
<script type="application/json" id="d-ridge">{{ trades_by_symbol_pct|tojson }}</script>
<script type="application/json" id="d-graph">{{ {"nodes": nodes, "edges": edges, "hubs": hubs}|tojson }}</script>
<script type="application/json" id="d-change">{{ change_24h_list|tojson }}</script>
<script type="application/json" id="d-cfg">{{ {"strike": strike_pct, "stop": stop_pct, "winRate": overall.win_rate_pct, "lossShare": loss_share_pct, "tailMass": tail_mass_pct, "impliedMultiple": implied_multiple, "medianReturn": median_return_pct, "predicted": predicted_dir, "pUp": p_up}|tojson }}</script>
<script>
{% include "_dash.js.j2" %}
</script>
</body>
</html>
