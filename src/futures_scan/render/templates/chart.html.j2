<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ symbol }} · futures-scan</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
<style>
{% include "_theme.css.j2" %}
#chart-container { width: 100%; height: 420px; }
#volume-container { width: 100%; height: 110px; margin-top: 4px; }
#rsi-container { width: 100%; height: 120px; margin-top: 4px; }
#whale-container { width: 100%; height: 120px; margin-top: 4px; }
.legend { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; font-size: 11px; color: var(--ink-soft); }
.legend b { color: var(--ink); }
.back-link { font-size: 11px; text-decoration: none; color: var(--ink-soft); }
.back-link:hover { color: var(--ink); }
.support-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.support-list .lvl { border: 1px dashed var(--line); border-radius: 4px; padding: 3px 8px; font-size: 11px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="brand">
      <div class="logo">◆</div>
      <div>
        <div class="label">futures-scan · {{ exchange|upper }} · {{ timeframe }}</div>
        <div style="font-weight:700; font-size: 15px;">{{ symbol }}</div>
      </div>
    </div>
    <div class="meta-right">
      <a class="back-link" href="../index.html">&larr; back to scan</a>
      <span class="chip">RSI {{ '%.1f'|format(rsi) if rsi is not none else 'N/A' }}</span>
      <span class="chip">VOL× {{ '%.2f'|format(vol_ratio) }}</span>
      <span class="chip {{ 'pos' if change_24h_pct is not none and change_24h_pct >= 0 else 'neg' }}">
        24H {{ '%.2f'|format(change_24h_pct) if change_24h_pct is not none else 'N/A' }}%
      </span>
      <span class="chip">{{ candle_count }} bars</span>
    </div>
  </div>

  <div class="card">
    <div class="legend">
      <span>candles + volume · {{ timeframe }}</span>
      <span>support: <b>{{ support_levels|length }}</b> clustered levels (pivot-low, &plusmn;0.5% tol, &ge;2 touches)</span>
      <span>entry zone: <b>{{ signal_bars|length }}</b> bars (RSI&lt;30 + vol&ge;3x &rarr; support &plusmn;0.5% band)</span>
    </div>
    <div id="chart-container"></div>
    <div id="volume-container"></div>
    <div class="label" style="margin-top:8px;">RSI(14)</div>
    <div id="rsi-container"></div>
    <div class="label" style="margin-top:8px;">WHALE-MOMENTUM (custom oscillator, -100..100)</div>
    <div id="whale-container"></div>
    <div class="support-list">
      {% for lvl in support_levels %}
      <div class="lvl">{{ '%.6g'|format(lvl.price) }} · {{ lvl.touches }} touches</div>
      {% else %}
      <div class="lvl neu">no clustered support found in this window</div>
      {% endfor %}
    </div>
  </div>

  <div class="footer">
    <span><span class="dot pos"></span> chart rendered client-side from cached OHLCV</span>
    <span>lightweight-charts v4</span>
  </div>
</div>

<script type="application/json" id="candles-data">{{ candles|tojson }}</script>
<script type="application/json" id="support-data">{{ support_levels|tojson }}</script>
<script type="application/json" id="signals-data">{{ signal_bars|tojson }}</script>
<script type="application/json" id="whale-data">{{ whale_momentum|tojson }}</script>
<script>
const candles = JSON.parse(document.getElementById('candles-data').textContent);
const supportLevels = JSON.parse(document.getElementById('support-data').textContent);
const signalBars = JSON.parse(document.getElementById('signals-data').textContent);
const whaleData = JSON.parse(document.getElementById('whale-data').textContent);

const chartOpts = {
  layout: { background: { color: '#fbfaf6' }, textColor: '#1c1b18', fontFamily: "'JetBrains Mono', monospace" },
  grid: { vertLines: { color: '#e3e0d5' }, horzLines: { color: '#e3e0d5' } },
  rightPriceScale: { borderColor: '#d8d5c8' },
  timeScale: { borderColor: '#d8d5c8', timeVisible: true, secondsVisible: false },
};

function el(id) { return document.getElementById(id); }

const priceChart = LightweightCharts.createChart(el('chart-container'), { ...chartOpts, width: el('chart-container').clientWidth, height: 420 });
const candleSeries = priceChart.addCandlestickSeries({
  upColor: '#2f7d4f', downColor: '#c8323c', borderVisible: false,
  wickUpColor: '#2f7d4f', wickDownColor: '#c8323c',
});
const candleData = candles.map(c => ({ time: Math.floor(c.timestamp / 1000), open: c.open, high: c.high, low: c.low, close: c.close }));
candleSeries.setData(candleData);

supportLevels.forEach(function (lvl) {
  candleSeries.createPriceLine({
    price: lvl.price, color: '#8a8778', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dashed,
    axisLabelVisible: true, title: 'support x' + lvl.touches,
  });
  // entry zone band: support +/- 0.5%
  candleSeries.createPriceLine({
    price: lvl.price * 1.005, color: 'rgba(47,125,79,0.35)', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dotted,
    axisLabelVisible: false, title: 'zone+',
  });
  candleSeries.createPriceLine({
    price: lvl.price * 0.995, color: 'rgba(47,125,79,0.35)', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dotted,
    axisLabelVisible: false, title: 'zone-',
  });
});

if (signalBars.length) {
  candleSeries.setMarkers(signalBars.map(s => ({
    time: Math.floor(s.timestamp / 1000), position: 'belowBar', color: '#2f7d4f', shape: 'arrowUp', text: 'ENTRY',
  })));
}

const volChart = LightweightCharts.createChart(el('volume-container'), { ...chartOpts, width: el('volume-container').clientWidth, height: 110, timeScale: { ...chartOpts.timeScale, visible: false } });
const volSeries = volChart.addHistogramSeries({ priceFormat: { type: 'volume' } });
volSeries.setData(candles.map(c => ({
  time: Math.floor(c.timestamp / 1000), value: c.volume,
  color: c.close >= c.open ? 'rgba(47,125,79,0.5)' : 'rgba(200,50,60,0.5)',
})));

const rsiChart = LightweightCharts.createChart(el('rsi-container'), { ...chartOpts, width: el('rsi-container').clientWidth, height: 120, timeScale: { ...chartOpts.timeScale, visible: false } });
const rsiSeries = rsiChart.addLineSeries({ color: '#1c1b18', lineWidth: 2 });
rsiSeries.setData(candles.filter(c => c.rsi !== null).map(c => ({ time: Math.floor(c.timestamp / 1000), value: c.rsi })));
rsiSeries.createPriceLine({ price: 30, color: '#c8323c', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dotted, title: '30' });
rsiSeries.createPriceLine({ price: 70, color: '#8a8778', lineWidth: 1, lineStyle: LightweightCharts.LineStyle.Dotted, title: '70' });

const whaleChart = LightweightCharts.createChart(el('whale-container'), { ...chartOpts, width: el('whale-container').clientWidth, height: 120 });
const whaleSeries = whaleChart.addHistogramSeries({});
whaleSeries.setData(whaleData.map(w => ({
  time: Math.floor(w.timestamp / 1000), value: w.value,
  color: w.value >= 0 ? 'rgba(47,125,79,0.6)' : 'rgba(200,50,60,0.6)',
})));

const allCharts = [priceChart, volChart, rsiChart, whaleChart];
allCharts.forEach(function (c) {
  const others = allCharts.filter(function (x) { return x !== c; });
  c.timeScale().subscribeVisibleLogicalRangeChange(function (range) {
    if (!range) return;
    others.forEach(function (o) { o.timeScale().setVisibleLogicalRange(range); });
  });
});

window.addEventListener('resize', function () {
  priceChart.applyOptions({ width: el('chart-container').clientWidth });
  volChart.applyOptions({ width: el('volume-container').clientWidth });
  rsiChart.applyOptions({ width: el('rsi-container').clientWidth });
  whaleChart.applyOptions({ width: el('whale-container').clientWidth });
});

priceChart.timeScale().fitContent();
</script>
</body>
</html>
