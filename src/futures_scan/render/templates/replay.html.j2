<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ symbol }} replay · futures-scan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Silkscreen:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
<style>
{% include "_theme.css.j2" %}
.layout { display: grid; grid-template-columns: 1fr 290px; gap: 12px; align-items: start; }
@media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
#chart-container { width: 100%; height: 420px; }
#vol-container { width: 100%; height: 100px; margin-top: 4px; }
.controls { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
.speed-group button.active { background: var(--ink); color: var(--bg); }
.panel-stat { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px dotted var(--line); font-size: 11px; }
.panel-stat:last-child { border-bottom: none; }
.open-trade { border: 1px solid var(--line); border-radius: 2px; padding: 5px 7px; margin-top: 6px; font-size: 10px; }
.trade-row { display: flex; justify-content: space-between; font-size: 11px; padding: 3px 0; border-bottom: 1px dotted var(--line); }
#trade-log { max-height: 220px; overflow-y: auto; margin-top: 8px; }
.back-link { font-size: 10px; color: var(--ink-soft); }
#mini-lattice { width: 100%; display: block; }
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="brand">
      <div class="logo">▶</div>
      <div>
        <div class="label">FUTURES-SCAN · REPLAY · {{ exchange|upper }} · {{ timeframe }} · LAST {{ days }} DAYS</div>
        <div class="title pixel">{{ symbol.split('/')[0] }} <span class="accent">REPLAY</span></div>
      </div>
    </div>
    <div class="meta-right">
      <a class="back-link" href="../index.html">&larr; back to scan</a>
      <span class="chip" id="progress-chip">0 / {{ candles|length }}</span>
    </div>
  </div>

  <div class="section">
    <div class="section-head">
      <h2><span class="bullet"></span>Candle Replay <span class="sub">· {{ symbol }}</span></h2>
      <span class="hint">js engine mirrors the python strategy · every fill drops one ball</span>
    </div>
    <div class="section-body">
    <div class="stat-col">
      <div class="col-title">replay ledger</div>
      {% for r in stat_rows %}
      <div class="srow"><span class="k">{{ r.label }}</span><span class="lead"></span><span class="v {{ r.tone }}">{{ r.value }}</span></div>
      {% endfor %}
      <div class="stat-note">one bar at a time — the same gate, replayed honestly</div>
    </div>
    <div class="pane">
    <div class="controls">
      <button class="ctrl" id="btn-play">▶ play</button>
      <button class="ctrl" id="btn-pause">&#10073;&#10073; pause</button>
      <button class="ctrl" id="btn-reset">&#8634; reset</button>
      <span class="label">speed</span>
      <span class="speed-group">
        <button class="ctrl" data-speed="1">1x</button>
        <button class="ctrl active" data-speed="4">4x</button>
        <button class="ctrl" data-speed="16">16x</button>
        <button class="ctrl" data-speed="64">64x</button>
      </span>
    </div>
    <div class="layout">
      <div>
        <div id="chart-container"></div>
        <div id="vol-container"></div>
      </div>
      <div class="card">
        <div class="label">strategy rules</div>
        <div style="font-size:11px; color:var(--ink-soft); margin-bottom:8px;">
          RSI(14)&lt;30 &amp; vol&ge;3x avg(20) on close &rarr; enter next open.
          TP +3% / SL -1.5% / max 24 bars. fee 0.04% one-way.
        </div>
        <div class="panel-stat"><span>closed trades</span><span id="stat-count">0</span></div>
        <div class="panel-stat"><span>win rate</span><span id="stat-winrate">0%</span></div>
        <div class="panel-stat"><span>realized pnl (usdt)</span><span id="stat-pnl">0.00</span></div>
        <div class="panel-stat"><span>open position</span><span id="stat-open">none</span></div>
        <div id="open-trade-box"></div>
        <div class="label" style="margin-top:10px;">fill lattice</div>
        <canvas id="mini-lattice" height="150"></canvas>
        <div class="label" style="margin-top:10px;">trade log</div>
        <div id="trade-log"></div>
      </div>
    </div>
    </div>
    </div>
  </div>

  <div class="statusbar">
    <span><span class="dot pos"></span> AGENT ONLINE · MODEL RSI-VOLSPIKE-V1 · SYMBOL {{ symbol }}</span>
    <span id="parity-chip">PYTHON REFERENCE FILLS <b>{{ python_trade_count }}</b> · JS ENGINE MIRRORS THE PYTHON RULES</span>
    <span>STACK <b>FUTURES-SCAN-CORE</b></span>
  </div>
</div>

<script type="application/json" id="candles-data">{{ candles|tojson }}</script>
<script type="application/json" id="python-trades-data">{{ python_trades|tojson }}</script>
<script>
// ---- Strategy engine (mirrors futures_scan/strategy.py + indicators.py exactly) ----
const RSI_PERIOD = 14;
const VOL_LOOKBACK = 20;
const RSI_THRESHOLD = 30;
const VOL_MULT = 3;
const TP_PCT = 0.03;
const SL_PCT = 0.015;
const MAX_HOLD_BARS = 24;
const FEE_ONE_WAY = 0.0004;
const NOTIONAL = 1000;

function computeRSI(closes, period) {
  const n = closes.length;
  const rsi = new Array(n).fill(null);
  const gains = new Array(n).fill(0);
  const losses = new Array(n).fill(0);
  for (let i = 1; i < n; i++) {
    const delta = closes[i] - closes[i - 1];
    gains[i] = Math.max(delta, 0);
    losses[i] = Math.max(-delta, 0);
  }
  const alpha = 1 / period;
  let avgGain = gains[0], avgLoss = losses[0];
  const avgGains = new Array(n).fill(null);
  const avgLosses = new Array(n).fill(null);
  avgGains[0] = avgGain; avgLosses[0] = avgLoss;
  for (let i = 1; i < n; i++) {
    avgGain = (1 - alpha) * avgGain + alpha * gains[i];
    avgLoss = (1 - alpha) * avgLoss + alpha * losses[i];
    avgGains[i] = avgGain; avgLosses[i] = avgLoss;
  }
  for (let i = period - 1; i < n; i++) {
    const ag = avgGains[i], al = avgLosses[i];
    if (al === 0 && ag === 0) rsi[i] = 50;
    else if (al === 0) rsi[i] = 100;
    else {
      const rs = ag / al;
      rsi[i] = 100 - 100 / (1 + rs);
    }
  }
  return rsi;
}

function computeVolRatio(volumes, lookback) {
  const n = volumes.length;
  const ratio = new Array(n).fill(null);
  for (let i = lookback; i < n; i++) {
    let sum = 0;
    for (let j = i - lookback; j < i; j++) sum += volumes[j];
    const avg = sum / lookback;
    ratio[i] = avg > 0 ? volumes[i] / avg : null;
  }
  return ratio;
}

function computeSignals(candles) {
  const closes = candles.map(c => c.close);
  const volumes = candles.map(c => c.volume);
  const rsi = computeRSI(closes, RSI_PERIOD);
  const volRatio = computeVolRatio(volumes, VOL_LOOKBACK);
  const n = candles.length;
  const signals = new Array(n).fill(false);
  for (let i = 0; i < n; i++) {
    if (rsi[i] === null || rsi[i] >= RSI_THRESHOLD) continue;
    const ratioNow = volRatio[i];
    const ratioPrev = i > 0 ? volRatio[i - 1] : null;
    const ok = (ratioNow !== null && ratioNow >= VOL_MULT) || (ratioPrev !== null && ratioPrev >= VOL_MULT);
    signals[i] = ok;
  }
  return { signals, rsi, volRatio };
}

function simulateTrade(candles, entryIndex) {
  const n = candles.length;
  if (entryIndex >= n) return null;
  const entryPrice = candles[entryIndex].open;
  const tpPrice = entryPrice * (1 + TP_PCT);
  const slPrice = entryPrice * (1 - SL_PCT);
  const lastBar = Math.min(entryIndex + MAX_HOLD_BARS, n - 1);
  for (let i = entryIndex; i <= lastBar; i++) {
    const bar = candles[i];
    let exitPrice = null, reason = null;
    if (bar.low <= slPrice) { exitPrice = slPrice; reason = 'sl'; }
    else if (bar.high >= tpPrice) { exitPrice = tpPrice; reason = 'tp'; }
    else if (i === lastBar) { exitPrice = bar.close; reason = 'time'; }
    else continue;
    const pnlPct = (exitPrice - entryPrice) / entryPrice;
    const grossPnl = pnlPct * NOTIONAL;
    const fees = NOTIONAL * FEE_ONE_WAY * 2;
    return {
      entryIndex, exitIndex: i, entryPrice, exitPrice, reason,
      pnlPct: pnlPct * 100, pnlUsdt: grossPnl - fees,
    };
  }
  return null;
}

function generateAllTrades(candles) {
  const { signals } = computeSignals(candles);
  const trades = [];
  let i = 0;
  const n = candles.length;
  while (i < n - 1) {
    if (signals[i]) {
      const entryIndex = i + 1;
      const trade = simulateTrade(candles, entryIndex);
      if (trade) { trades.push(trade); i = trade.exitIndex + 1; continue; }
    }
    i++;
  }
  return trades;
}

// ---- Replay UI ----
const candles = JSON.parse(document.getElementById('candles-data').textContent);
const pythonTrades = JSON.parse(document.getElementById('python-trades-data').textContent);
const { signals } = computeSignals(candles);

const chartOpts = {
  layout: { background: { color: '#fbfaf7' }, textColor: '#14130f', fontFamily: "'IBM Plex Mono', monospace" },
  grid: { vertLines: { color: '#eeebe3' }, horzLines: { color: '#eeebe3' } },
  rightPriceScale: { borderColor: '#d9d5cc' },
  timeScale: { borderColor: '#d9d5cc', timeVisible: true, secondsVisible: false },
};
function el(id) { return document.getElementById(id); }
const priceChart = LightweightCharts.createChart(el('chart-container'), { ...chartOpts, width: el('chart-container').clientWidth, height: 420 });
const candleSeries = priceChart.addCandlestickSeries({ upColor: '#2c7a4b', downColor: '#bf2f38', borderVisible: false, wickUpColor: '#2c7a4b', wickDownColor: '#bf2f38' });
const volChart = LightweightCharts.createChart(el('vol-container'), { ...chartOpts, width: el('vol-container').clientWidth, height: 100, timeScale: { ...chartOpts.timeScale, visible: false } });
const volSeries = volChart.addHistogramSeries({ priceFormat: { type: 'volume' } });

let cursor = 0;
let playing = false;
let speed = 4;
let openTrade = null; // { entryIndex, entryPrice, tpPrice, slPrice, maxIndex }
let closedTrades = [];
let realizedPnl = 0;
const markers = [];

function toTime(ts) { return Math.floor(ts / 1000); }

function resetState() {
  cursor = 0; playing = false; openTrade = null; closedTrades = []; realizedPnl = 0; markers.length = 0;
  candleSeries.setData([]); volSeries.setData([]);
  candleSeries.setMarkers([]);
  renderStats(); renderLog();
}

function renderStats() {
  el('stat-count').textContent = closedTrades.length;
  const wins = closedTrades.filter(t => t.pnlUsdt > 0).length;
  el('stat-winrate').textContent = closedTrades.length ? (100 * wins / closedTrades.length).toFixed(1) + '%' : '0%';
  el('stat-pnl').textContent = realizedPnl.toFixed(2);
  el('stat-pnl').className = realizedPnl >= 0 ? 'pos' : 'neg';
  if (openTrade) {
    el('stat-open').textContent = 'LONG @ ' + openTrade.entryPrice.toFixed(6);
    el('open-trade-box').innerHTML = `<div class="open-trade">entry ${openTrade.entryPrice.toFixed(6)} · tp ${openTrade.tpPrice.toFixed(6)} · sl ${openTrade.slPrice.toFixed(6)} · bar ${cursor - openTrade.entryIndex}/${MAX_HOLD_BARS}</div>`;
  } else {
    el('stat-open').textContent = 'none';
    el('open-trade-box').innerHTML = '';
  }
  el('progress-chip').textContent = cursor + ' / ' + candles.length;
}

function renderLog() {
  const rows = closedTrades.slice().reverse().map(t => {
    const cls = t.pnlUsdt >= 0 ? 'pos' : 'neg';
    return `<div class="trade-row"><span>${t.reason.toUpperCase()} @ ${t.exitPrice.toFixed(6)}</span><span class="${cls}">${t.pnlUsdt.toFixed(2)}</span></div>`;
  }).join('');
  el('trade-log').innerHTML = rows || '<div class="label">no closed trades yet</div>';
}

function step() {
  if (cursor >= candles.length) { playing = false; return; }
  const bar = candles[cursor];
  candleSeries.update({ time: toTime(bar.timestamp), open: bar.open, high: bar.high, low: bar.low, close: bar.close });
  volSeries.update({ time: toTime(bar.timestamp), value: bar.volume, color: bar.close >= bar.open ? 'rgba(44,122,75,0.5)' : 'rgba(191,47,56,0.5)' });

  // manage open trade first (SL checked before TP, matches Python)
  if (openTrade) {
    let exitPrice = null, reason = null;
    if (bar.low <= openTrade.slPrice) { exitPrice = openTrade.slPrice; reason = 'sl'; }
    else if (bar.high >= openTrade.tpPrice) { exitPrice = openTrade.tpPrice; reason = 'tp'; }
    else if (cursor >= openTrade.maxIndex) { exitPrice = bar.close; reason = 'time'; }
    if (exitPrice !== null) {
      const pnlPct = (exitPrice - openTrade.entryPrice) / openTrade.entryPrice;
      const pnlUsdt = pnlPct * NOTIONAL - NOTIONAL * FEE_ONE_WAY * 2;
      closedTrades.push({ exitPrice, reason, pnlUsdt, pnlPct: pnlPct * 100 });
      if (window.__dropBall) window.__dropBall(pnlPct * 100);
      realizedPnl += pnlUsdt;
      markers.push({ time: toTime(bar.timestamp), position: 'aboveBar', color: pnlUsdt >= 0 ? '#2c7a4b' : '#bf2f38', shape: 'arrowDown', text: 'EXIT ' + reason.toUpperCase() });
      openTrade = null;
    }
  } else if (cursor > 0 && signals[cursor - 1]) {
    // signal on previous bar's close -> enter at this bar's open
    const entryPrice = bar.open;
    openTrade = {
      entryIndex: cursor, entryPrice,
      tpPrice: entryPrice * (1 + TP_PCT), slPrice: entryPrice * (1 - SL_PCT),
      maxIndex: Math.min(cursor + MAX_HOLD_BARS, candles.length - 1),
    };
    markers.push({ time: toTime(bar.timestamp), position: 'belowBar', color: '#14130f', shape: 'arrowUp', text: 'ENTRY' });
  }
  candleSeries.setMarkers(markers);
  cursor++;
  renderStats();
  renderLog();
}

let timer = null;
function tick() {
  if (!playing) return;
  const stepsPerTick = Math.max(1, Math.floor(speed / 4));
  for (let k = 0; k < stepsPerTick && cursor < candles.length; k++) step();
  if (cursor >= candles.length) { playing = false; return; }
  timer = setTimeout(tick, Math.max(16, 250 / speed));
}

el('btn-play').addEventListener('click', () => { if (!playing) { playing = true; tick(); } });
el('btn-pause').addEventListener('click', () => { playing = false; if (timer) clearTimeout(timer); });
el('btn-reset').addEventListener('click', () => { playing = false; if (timer) clearTimeout(timer); if (window.__resetLattice) window.__resetLattice(); resetState(); });
document.querySelectorAll('.speed-group button').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.speed-group button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    speed = parseInt(btn.dataset.speed, 10);
  });
});

window.addEventListener('resize', () => {
  priceChart.applyOptions({ width: el('chart-container').clientWidth });
  volChart.applyOptions({ width: el('vol-container').clientWidth });
});

// ---- mini probability lattice: one ball per closed fill ----
(function () {
  const cv = document.getElementById('mini-lattice');
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const TIERS = 7, BINS = 7;
  let W = 260, H = 150, SP = 26, cx = 130;
  const topY = 14, botY = 78, histBot = 132;
  let counts = new Array(BINS).fill(0);
  let balls = [];
  function resize() {
    W = Math.max(180, cv.parentNode.getBoundingClientRect().width);
    SP = Math.max(16, Math.min(30, (W - 20) / (BINS + 0.6)));
    cx = W / 2;
    const dpr = window.devicePixelRatio || 1;
    cv.width = W * dpr; cv.height = H * dpr; cv.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  function binFor(r) { return Math.max(-3, Math.min(3, Math.sign(r) * Math.round(Math.abs(r)))); }
  window.__dropBall = function (pnlPct) {
    const target = binFor(pnlPct), rights = target + 3;
    const moves = [];
    for (let i = 0; i < 6; i++) moves.push(i < rights ? 1 : -1);
    for (let i = moves.length - 1; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; const t = moves[i]; moves[i] = moves[j]; moves[j] = t; }
    moves.splice(3, 0, 0);
    balls.push({ bin: target, moves, p: 0, trail: [], win: pnlPct > 0 });
  };
  window.__resetLattice = function () { counts = new Array(BINS).fill(0); balls = []; };
  function pos(b) {
    const rowH = (botY - topY) / TIERS;
    const stage = Math.min(TIERS, Math.floor(b.p)), frac = b.p - stage;
    let off = 0;
    for (let i = 0; i < Math.min(stage, TIERS); i++) off += b.moves[i];
    let x = cx + off * SP / 2;
    let y = topY + Math.min(b.p, TIERS) * rowH;
    if (stage < TIERS) x += b.moves[stage] * (SP / 2) * frac;
    if (b.p > TIERS) y = botY + (b.p - TIERS) * rowH * 1.4;
    return { x, y };
  }
  function frame() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#f2efe7'; ctx.fillRect(0, 0, cx - SP / 2, H - 10);
    ctx.fillStyle = 'rgba(44,122,75,0.07)'; ctx.fillRect(cx - SP / 2, 0, W, H - 10);
    ctx.save(); ctx.setLineDash([2, 2]); ctx.strokeStyle = '#8f8c80';
    ctx.beginPath(); ctx.moveTo(cx - SP / 2, 4); ctx.lineTo(cx - SP / 2, histBot + 2); ctx.stroke(); ctx.restore();
    const rowH = (botY - topY) / TIERS;
    ctx.fillStyle = '#d9d5cc';
    for (let r = 0; r < TIERS; r++) {
      const n = Math.min(r + 2, BINS + 1), y = topY + (r + 0.5) * rowH;
      for (let c = 0; c < n; c++) {
        const x = cx + (c - (n - 1) / 2) * SP;
        ctx.beginPath(); ctx.arc(x, y, 1.4, 0, 6.2832); ctx.fill();
      }
    }
    for (let i = balls.length - 1; i >= 0; i--) {
      const b = balls[i];
      b.p += 0.10;
      const pt = pos(b);
      b.trail.push(pt); if (b.trail.length > 9) b.trail.shift();
      for (let k = 0; k < b.trail.length; k++) {
        ctx.fillStyle = 'rgba(20,19,15,' + ((k / b.trail.length) * 0.25).toFixed(3) + ')';
        ctx.beginPath(); ctx.arc(b.trail[k].x, b.trail[k].y, 1.1, 0, 6.2832); ctx.fill();
      }
      ctx.fillStyle = '#14130f'; ctx.fillRect(pt.x - 1.7, pt.y - 1.7, 3.4, 3.4);
      if (pt.y > histBot - 4) { counts[b.bin + 3]++; balls.splice(i, 1); }
    }
    const mx = Math.max(1, Math.max.apply(null, counts));
    for (let i = 0; i < BINS; i++) {
      const bin = i - 3, w = SP * 0.74, x = cx + bin * SP - w / 2;
      const h = (counts[i] / mx) * (histBot - 86), y = histBot - h;
      ctx.fillStyle = bin > 0 ? 'rgba(44,122,75,0.75)' : 'rgba(143,140,128,0.65)';
      if (h > 0.5) ctx.fillRect(x, y, w, h);
      if (counts[i]) {
        ctx.fillStyle = '#6b6860'; ctx.font = '7px "IBM Plex Mono", monospace'; ctx.textAlign = 'center';
        ctx.fillText(String(counts[i]), x + w / 2, y - 2);
      }
      ctx.fillStyle = '#9a978c'; ctx.font = '7px "IBM Plex Mono", monospace'; ctx.textAlign = 'center';
      ctx.fillText((bin > 0 ? '+' : '') + bin, x + w / 2, histBot + 9);
    }
    requestAnimationFrame(frame);
  }
  resize();
  window.addEventListener('resize', resize);
  requestAnimationFrame(frame);
})();

resetState();

// Sanity check: full-speed JS backtest trade count should match the Python reference.
const jsTrades = generateAllTrades(candles);
if (jsTrades.length !== pythonTrades.length) {
  console.warn('JS/Python trade count mismatch', jsTrades.length, pythonTrades.length);
} else {
  console.log('JS/Python trade count parity OK:', jsTrades.length);
}
window.__jsTrades = jsTrades; // exposed for headless test harnesses
</script>
</body>
</html>
