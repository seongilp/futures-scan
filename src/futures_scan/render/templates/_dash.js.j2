/* futures-scan dashboard — all values come from the embedded JSON payloads. */
(function () {
  'use strict';
  var INK = '#14130f', SOFT = '#6b6860', FAINT = '#9a978c', LINE = '#d9d5cc',
      GREEN = '#2c7a4b', RED = '#bf2f38', GRAY = '#8f8c80', CARD = '#fbfaf7', ALT = '#f2efe7';

  function J(id) {
    var el = document.getElementById(id);
    if (!el) return null;
    try { return JSON.parse(el.textContent); } catch (e) { return null; }
  }
  var CURVE = J('d-curve') || [], TRADES = J('d-trades') || [], WINS = J('d-wins') || [],
      RIDGE = J('d-ridge') || {}, GRAPH = J('d-graph') || { nodes: [], edges: [], hubs: [] },
      CHANGE = J('d-change') || [], CFG = J('d-cfg') || {};

  var PIXEL = "'Silkscreen', monospace", MONO = "'IBM Plex Mono', monospace";

  /* ------------------------------------------------------------------ clock */
  setInterval(function () {
    var el = document.getElementById('utc-clock');
    if (el) el.textContent = new Date().toUTCString().split(' ')[4] + ' UTC';
  }, 1000);

  /* -------------------------------------------------- cumulative pnl curve */
  (function () {
    var svg = document.getElementById('pnl-curve');
    if (!svg || !CURVE.length) return;
    var W = 320, H = 132, pad = 6;
    var data = CURVE.length === 1 ? [0, CURVE[0]] : [0].concat(CURVE);
    var min = Math.min.apply(null, data), max = Math.max.apply(null, data);
    var span = (max - min) || 1;
    var xs = function (i) { return pad + (i / (data.length - 1)) * (W - pad * 2); };
    var ys = function (v) { return H - pad - ((v - min) / span) * (H - pad * 2 - 10); };
    var line = '', area = 'M ' + xs(0).toFixed(1) + ' ' + (H - pad).toFixed(1) + ' L ' + xs(0).toFixed(1) + ' ' + ys(data[0]).toFixed(1);
    for (var i = 0; i < data.length; i++) {
      var x = xs(i).toFixed(1), y = ys(data[i]).toFixed(1);
      if (i === 0) { line = 'M ' + x + ' ' + y; }
      else {
        var px = xs(i - 1).toFixed(1);
        line += ' L ' + x + ' ' + ys(data[i - 1]).toFixed(1) + ' L ' + x + ' ' + y;
        area += ' L ' + x + ' ' + ys(data[i - 1]).toFixed(1) + ' L ' + x + ' ' + y;
      }
    }
    area += ' L ' + xs(data.length - 1).toFixed(1) + ' ' + (H - pad).toFixed(1) + ' Z';
    var last = data[data.length - 1];
    var col = last >= 0 ? GREEN : RED;
    var zeroY = ys(0).toFixed(1);
    svg.innerHTML =
      '<line x1="' + pad + '" y1="' + zeroY + '" x2="' + (W - pad) + '" y2="' + zeroY + '" stroke="' + LINE + '" stroke-dasharray="2,3"/>' +
      '<path d="' + area + '" fill="' + (last >= 0 ? 'rgba(44,122,75,0.16)' : 'rgba(191,47,56,0.14)') + '"/>' +
      '<path d="' + line + '" fill="none" stroke="' + col + '" stroke-width="1.4" vector-effect="non-scaling-stroke"/>' +
      '<circle cx="' + xs(data.length - 1).toFixed(1) + '" cy="' + ys(last).toFixed(1) + '" r="2.4" fill="' + col + '"/>';
  })();

  /* -------------------------------------------------------- top-wins pager */
  (function () {
    if (!WINS.length) return;
    var dots = document.getElementById('pager-dots');
    var idx = 0;
    function set(html, id) { var el = document.getElementById(id); if (el) el.innerHTML = html; }
    function render() {
      var w = WINS[idx];
      set('&times;' + w.multiple.toFixed(3), 'win-mult');
      set('+' + w.pnl_pct.toFixed(2) + '%', 'win-plus');
      set(w.entry_time_short + ' · ' + w.short + ' · ' + w.exit_reason.toUpperCase() + ' · ' + w.bars_held + ' BARS', 'win-meta');
      set(Number(w.entry_price).toPrecision(6).replace(/\.?0+$/, ''), 'win-entry');
      set(Number(w.exit_price).toPrecision(6).replace(/\.?0+$/, ''), 'win-exit');
      var pnl = document.getElementById('win-pnl');
      if (pnl) { pnl.textContent = (w.pnl_usdt >= 0 ? '+' : '') + w.pnl_usdt.toFixed(2) + ' USDT'; pnl.className = w.pnl_usdt >= 0 ? 'pos' : 'neg'; }
      var pager = document.getElementById('wins-pager');
      if (pager) pager.textContent = (idx + 1) + ' / ' + WINS.length;
      if (dots) dots.innerHTML = WINS.map(function (_, i) { return '<i class="' + (i === idx ? 'on' : '') + '" data-i="' + i + '"></i>'; }).join('');
    }
    render();
    if (dots) dots.addEventListener('click', function (e) {
      var i = e.target && e.target.getAttribute('data-i');
      if (i !== null && i !== undefined) { idx = +i; render(); }
    });
    if (WINS.length > 1) setInterval(function () { idx = (idx + 1) % WINS.length; render(); }, 3800);
  })();

  /* ---------------------------------------------------- probability lattice */
  (function () {
    var cv = document.getElementById('lattice');
    if (!cv || !TRADES.length) return;
    var ctx = cv.getContext('2d');
    var ROWS = 6, TIERS = 9, BINS = 7, H = 348;
    var W = 800, SP = 40, cx = 0, topY = 58, botY = 196, histTop = 214, histBot = 300;
    var counts = new Array(BINS).fill(0), greens = new Array(BINS).fill(0);
    var balls = [], order = [], cursor = 0, landed = 0, wins = 0, conv = [];

    function binFor(r) {
      var b = Math.sign(r) * Math.round(Math.abs(r));
      return Math.max(-3, Math.min(3, b));
    }
    function resize() {
      var rect = cv.parentNode.getBoundingClientRect();
      W = Math.max(640, Math.floor(rect.width));
      SP = Math.min(104, Math.max(40, (W - 160) / (BINS + 1.1)));
      cx = W / 2;
      var dpr = window.devicePixelRatio || 1;
      cv.width = W * dpr; cv.height = H * dpr;
      cv.style.height = H + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function reset() {
      counts.fill(0); greens.fill(0); balls = []; cursor = 0; landed = 0; wins = 0; conv = [];
      order = TRADES.slice();
    }
    function spawn() {
      if (cursor >= order.length) return;
      var t = order[cursor++];
      var target = binFor(t.pnl_pct);
      var rights = target + 3;
      var moves = [];
      for (var i = 0; i < ROWS; i++) moves.push(i < rights ? 1 : -1);
      for (var i = moves.length - 1; i > 0; i--) { var j = (Math.random() * (i + 1)) | 0; var tmp = moves[i]; moves[i] = moves[j]; moves[j] = tmp; }
      // spread the 6 real decisions over 9 peg tiers (3 pass-through tiers)
      var pad = [2, 5, 8], full = [], mi = 0;
      for (var i = 0; i < TIERS; i++) full.push(pad.indexOf(i) >= 0 ? 0 : moves[mi++]);
      moves = full;
      balls.push({ t: t, bin: target, moves: moves, p: 0, trail: [], rot: Math.random() * 6, done: false });
    }
    function ballPos(b, p) {
      var rowH = (botY - topY) / TIERS;
      var stage = Math.min(TIERS, Math.floor(p));
      var frac = p - stage;
      var off = 0;
      for (var i = 0; i < Math.min(stage, TIERS); i++) off += b.moves[i];
      var x = cx + off * SP / 2;
      var y = topY + Math.min(p, TIERS) * rowH;
      if (stage < TIERS) x += b.moves[stage] * (SP / 2) * frac;
      if (p > TIERS) y = botY + (p - TIERS) * rowH * 1.35;
      return { x: x, y: y };
    }
    function drawStatic() {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = ALT; ctx.fillRect(0, 0, cx - SP / 2, H - 26);
      ctx.fillStyle = 'rgba(44,122,75,0.07)'; ctx.fillRect(cx - SP / 2, 0, W - cx + SP / 2, H - 26);
      // funnel
      ctx.strokeStyle = INK; ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(cx - 16, 16); ctx.lineTo(cx + 16, 16); ctx.lineTo(cx + 3, 40); ctx.lineTo(cx + 3, 50);
      ctx.lineTo(cx - 3, 50); ctx.lineTo(cx - 3, 40); ctx.closePath(); ctx.stroke();
      // breakeven line
      ctx.save();
      ctx.setLineDash([3, 3]); ctx.strokeStyle = SOFT;
      ctx.beginPath(); ctx.moveTo(cx - SP / 2, 8); ctx.lineTo(cx - SP / 2, histBot + 4); ctx.stroke();
      ctx.restore();
      // labels
      ctx.font = '9px ' + MONO; ctx.textAlign = 'left';
      ctx.fillStyle = FAINT; ctx.fillText('LOSS · ' + (CFG.lossShare || 0).toFixed(1) + '%', 14, 22);
      ctx.fillStyle = GREEN; ctx.textAlign = 'right'; ctx.fillText('PROFIT · ' + (CFG.winRate || 0).toFixed(1) + '%', W - 14, 22);
      // breakeven box
      ctx.textAlign = 'center';
      var bx = cx - SP / 2, tw = 62;
      ctx.fillStyle = CARD; ctx.fillRect(bx - tw / 2, 10, tw, 13);
      ctx.strokeStyle = LINE; ctx.lineWidth = 1; ctx.strokeRect(bx - tw / 2, 10, tw, 13);
      ctx.fillStyle = INK; ctx.font = '8px ' + MONO; ctx.fillText('BREAKEVEN', bx, 19.5);
      // pegs
      var rowH = (botY - topY) / TIERS;
      ctx.fillStyle = LINE;
      for (var r = 0; r < TIERS; r++) {
        var n = Math.min(r + 2, BINS + 2), y = topY + (r + 0.5) * rowH;
        for (var c = 0; c < n; c++) {
          var x = cx + (c - (n - 1) / 2) * SP;
          ctx.beginPath(); ctx.arc(x, y, 2.1, 0, 6.2832); ctx.fill();
        }
      }
      // quincunx caption
      ctx.textAlign = 'left'; ctx.fillStyle = FAINT; ctx.font = '8px ' + MONO;
      ctx.fillText('QUINCUNX · ' + TIERS + ' TIERS · BIN 1.00%', 14, 40);
    }
    function drawHist() {
      var max = Math.max(1, Math.max.apply(null, counts));
      for (var i = 0; i < BINS; i++) {
        var bin = i - 3;
        var w = SP * 0.78;
        var x = cx + bin * SP - w / 2;
        var h = (counts[i] / max) * (histBot - histTop);
        var y = histBot - h;
        ctx.fillStyle = bin > 0 ? 'rgba(44,122,75,0.75)' : (bin === 0 ? 'rgba(143,140,128,0.55)' : 'rgba(143,140,128,0.7)');
        if (h > 0.5) ctx.fillRect(x, y, w, h);
        ctx.font = '8px ' + MONO; ctx.textAlign = 'center';
        if (counts[i]) { ctx.fillStyle = SOFT; ctx.fillText(String(counts[i]), x + w / 2, y - 3); }
        ctx.fillStyle = FAINT;
        ctx.fillText((bin > 0 ? '+' : '') + bin, x + w / 2, histBot + 11);
      }
      ctx.strokeStyle = LINE; ctx.beginPath();
      ctx.moveTo(cx - 3.6 * SP, histBot + 0.5); ctx.lineTo(cx + 3.6 * SP, histBot + 0.5); ctx.stroke();
      ctx.textAlign = 'left'; ctx.fillStyle = FAINT; ctx.font = '8px ' + MONO;
      ctx.fillText('TRADE RETURN BIN (%)', cx - 3.6 * SP, histBot + 24);
    }
    function drawConv() {
      if (conv.length < 2) return;
      var w = 150, h = 42, x0 = W - w - 14, y0 = 34;
      ctx.fillStyle = CARD; ctx.fillRect(x0, y0, w, h);
      ctx.strokeStyle = LINE; ctx.lineWidth = 1; ctx.strokeRect(x0 + 0.5, y0 + 0.5, w - 1, h - 1);
      var lo = 0, hi = 100;
      ctx.beginPath();
      for (var i = 0; i < conv.length; i++) {
        var x = x0 + 4 + (i / (conv.length - 1)) * (w - 40);
        var y = y0 + h - 6 - ((conv[i] - lo) / (hi - lo)) * (h - 12);
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      }
      ctx.strokeStyle = INK; ctx.lineWidth = 1.1; ctx.stroke();
      ctx.save(); ctx.setLineDash([2, 2]); ctx.strokeStyle = LINE;
      var ty = y0 + h - 6 - ((CFG.winRate || 0) / 100) * (h - 12);
      ctx.beginPath(); ctx.moveTo(x0 + 4, ty); ctx.lineTo(x0 + w - 34, ty); ctx.stroke(); ctx.restore();
      ctx.font = '8px ' + MONO; ctx.textAlign = 'left'; ctx.fillStyle = GREEN;
      ctx.fillText(conv[conv.length - 1].toFixed(1) + '%', x0 + w - 32, y0 + h / 2 + 3);
      ctx.fillStyle = FAINT; ctx.fillText('RUNNING GREEN RATE', x0 + 4, y0 - 4);
    }
    function frame() {
      drawStatic();
      for (var i = balls.length - 1; i >= 0; i--) {
        var b = balls[i];
        b.p += 0.065;
        b.rot += 0.16;
        var pos = ballPos(b, b.p);
        b.trail.push(pos);
        if (b.trail.length > 14) b.trail.shift();
        for (var k = 0; k < b.trail.length; k++) {
          var a = (k / b.trail.length) * 0.28;
          ctx.fillStyle = 'rgba(20,19,15,' + a.toFixed(3) + ')';
          ctx.beginPath(); ctx.arc(b.trail[k].x, b.trail[k].y, 1.3, 0, 6.2832); ctx.fill();
        }
        ctx.save();
        ctx.translate(pos.x, pos.y); ctx.rotate(b.rot);
        ctx.fillStyle = INK; ctx.fillRect(-2.1, -2.1, 4.2, 4.2);
        ctx.restore();
        if (pos.y > histBot - 6) {
          var bi = b.bin + 3;
          counts[bi]++; if (b.t.win) { greens[bi]++; wins++; }
          landed++;
          conv.push(100 * wins / landed);
          if (conv.length > 120) conv.shift();
          balls.splice(i, 1);
        }
      }
      drawHist();
      drawConv();
      requestAnimationFrame(frame);
    }
    resize(); reset();
    window.addEventListener('resize', function () { resize(); });
    setInterval(function () {
      if (cursor >= order.length && balls.length === 0) { reset(); return; }
      if (balls.length > 26) return;
      spawn();
    }, 130);
    requestAnimationFrame(frame);
  })();

  /* ------------------------------------------------------------ tail ridge */
  (function () {
    var svg = document.getElementById('ridge');
    if (!svg) return;
    var syms = Object.keys(RIDGE);
    if (!syms.length) return;
    var all = [];
    syms.forEach(function (s) { all = all.concat(RIDGE[s]); });
    var mean = all.reduce(function (a, b) { return a + b; }, 0) / all.length;
    var sd = Math.sqrt(all.reduce(function (a, b) { return a + (b - mean) * (b - mean); }, 0) / Math.max(1, all.length - 1)) || 1;
    var lo = mean - 3.6 * sd, hi = mean + 3.6 * sd;
    var strike = CFG.strike || 3;
    if (strike > hi) hi = strike + 0.4 * sd;

    var W = 1080, H = 460, L = 132, R = 92, TOP = 46, BOT = 74;
    var plotW = W - L - R;
    // sort: biggest tail share at the back
    syms.sort(function (a, b) {
      var f = function (v) { return RIDGE[v].filter(function (x) { return x >= strike - 1e-9; }).length / RIDGE[v].length; };
      return f(b) - f(a);
    });
    var rows = syms.length + 1; // + aggregate ridge in front
    var dx = Math.min(13, (plotW * 0.26) / Math.max(1, rows));
    var dy = Math.min(19, (H - TOP - BOT) * 0.70 / Math.max(1, rows));
    var baseY = H - BOT;
    var ridgeW = plotW - dx * rows;
    var amp = Math.min(56, dy * 3.6);

    function xOf(v, i) { return L + dx * i + ((v - lo) / (hi - lo)) * ridgeW; }
    function yBase(i) { return baseY - dy * i; }

    function density(vals) {
      var n = 96, out = [], bw = Math.max(0.28 * sd, 0.16);
      for (var i = 0; i < n; i++) {
        var x = lo + (i / (n - 1)) * (hi - lo), s = 0;
        for (var k = 0; k < vals.length; k++) {
          var z = (x - vals[k]) / bw;
          s += Math.exp(-0.5 * z * z);
        }
        out.push({ x: x, y: s / (vals.length * bw) });
      }
      var mx = out.reduce(function (a, p) { return Math.max(a, p.y); }, 0) || 1;
      out.forEach(function (p) { p.y /= mx; });
      return out;
    }

    var parts = [];
    // back to front: index rows-1 (farthest) .. 0 (front). aggregate = index 0
    var series = syms.map(function (s) { return { name: s.split('/')[0].toLowerCase(), vals: RIDGE[s], agg: false }; });
    series.push({ name: 'all trades', vals: all, agg: true });
    // draw farthest first
    for (var si = series.length - 1; si >= 0; si--) {
      var i = si; // stack index: 0 = front (aggregate is last -> index series.length-1?)
      var item = series[si];
      var depth = item.agg ? 0 : (si + 1);
      var d = density(item.vals);
      var by = yBase(depth), a = item.agg ? amp * 1.25 : amp;
      var pts = d.map(function (p) { return [xOf(p.x, depth), by - p.y * a]; });
      var path = 'M ' + xOf(lo, depth).toFixed(1) + ' ' + by.toFixed(1);
      pts.forEach(function (p) { path += ' L ' + p[0].toFixed(1) + ' ' + p[1].toFixed(1); });
      path += ' L ' + xOf(hi, depth).toFixed(1) + ' ' + by.toFixed(1) + ' Z';
      parts.push({ z: depth, html:
        '<path d="' + path + '" fill="' + (item.agg ? 'rgba(20,19,15,0.18)' : 'rgba(143,140,128,0.16)') + '" stroke="' + INK + '" stroke-width="' + (item.agg ? 1.1 : 0.6) + '" stroke-opacity="' + (item.agg ? 0.85 : 0.55) + '"/>' });
      // red tail beyond strike
      var tail = pts.filter(function (p) { return p[0] >= xOf(strike, depth); });
      if (tail.length > 1) {
        var tp = 'M ' + tail[0][0].toFixed(1) + ' ' + by.toFixed(1);
        tail.forEach(function (p) { tp += ' L ' + p[0].toFixed(1) + ' ' + p[1].toFixed(1); });
        tp += ' L ' + tail[tail.length - 1][0].toFixed(1) + ' ' + by.toFixed(1) + ' Z';
        parts.push({ z: depth, html: '<path d="' + tp + '" fill="rgba(191,47,56,0.45)" stroke="' + RED + '" stroke-width="0.6"/>' });
      }
      parts.push({ z: depth, html: '<text class="axis-txt" x="' + (xOf(lo, depth) - 6).toFixed(1) + '" y="' + (by - 1).toFixed(1) + '" text-anchor="end">' + item.name + '</text>' });
    }
    parts.sort(function (a, b) { return b.z - a.z; });
    var html = parts.map(function (p) { return p.html; }).join('');

    // strike diagonal
    var sx0 = xOf(strike, series.length - 1 + 1), sy0 = yBase(series.length) - amp - 8;
    var sx1 = xOf(strike, 0), sy1 = yBase(0) + 8;
    html += '<line x1="' + sx0.toFixed(1) + '" y1="' + sy0.toFixed(1) + '" x2="' + sx1.toFixed(1) + '" y2="' + sy1.toFixed(1) + '" stroke="' + INK + '" stroke-dasharray="5,4" stroke-width="1"/>';
    html += '<g><rect x="' + (sx0 - 34).toFixed(1) + '" y="' + (sy0 - 15).toFixed(1) + '" width="74" height="14" fill="' + CARD + '" stroke="' + INK + '" stroke-width="0.7"/>' +
      '<text class="boxlabel" x="' + (sx0 + 3).toFixed(1) + '" y="' + (sy0 - 5).toFixed(1) + '" text-anchor="middle" fill="' + INK + '">STRIKE +' + strike.toFixed(0) + '%</text></g>';

    // annotation box
    var im = CFG.impliedMultiple ? ('x' + CFG.impliedMultiple.toFixed(1)) : 'n/a';
    var ax = L + 6, ay = TOP + 4;
    html += '<g><rect x="' + ax + '" y="' + ay + '" width="164" height="46" fill="' + CARD + '" stroke="' + INK + '" stroke-width="0.7"/>' +
      '<text class="boxlabel" x="' + (ax + 8) + '" y="' + (ay + 15) + '" fill="' + INK + '">P(&ge;STRIKE) ' + (CFG.tailMass || 0).toFixed(2) + '%</text>' +
      '<text class="boxlabel" x="' + (ax + 8) + '" y="' + (ay + 28) + '" fill="' + RED + '">IMPLIED ' + im + '</text>' +
      '<text class="boxlabel" x="' + (ax + 8) + '" y="' + (ay + 41) + '" fill="' + FAINT + '">MEDIAN ' + (CFG.medianReturn || 0).toFixed(2) + '%</text></g>';

    // axis ticks in sigma
    for (var t = -3; t <= 3; t++) {
      var v = mean + t * sd;
      var x = xOf(v, 0);
      html += '<line x1="' + x.toFixed(1) + '" y1="' + (baseY + 4) + '" x2="' + x.toFixed(1) + '" y2="' + (baseY + 9) + '" stroke="' + LINE + '"/>';
      html += '<text class="axis-txt" x="' + x.toFixed(1) + '" y="' + (baseY + 20) + '" text-anchor="middle">' + (t > 0 ? '+' : '') + t + 'σ</text>';
    }
    html += '<line x1="' + xOf(lo, 0).toFixed(1) + '" y1="' + (baseY + 4) + '" x2="' + xOf(hi, 0).toFixed(1) + '" y2="' + (baseY + 4) + '" stroke="' + LINE + '"/>';
    html += '<text class="axis-txt" x="' + (L - 60) + '" y="' + (TOP - 20) + '">PRICE-TARGET DENSITY · ' + syms.length + ' SYMBOLS</text>';
    html += '<text class="axis-txt" x="' + (W - 8) + '" y="' + (TOP - 20) + '" text-anchor="end" fill="' + RED + '">TAIL ZONE · PAYOUT ' + im + '</text>';
    svg.innerHTML = html;
  })();

  /* ------------------------------------------------------ relationship graph */
  (function () {
    var el = document.getElementById('graph');
    if (!el || typeof d3 === 'undefined' || !GRAPH.nodes.length) return;
    var W = 960, H = 470;
    var hubMeta = { BEAR_CLUSTER: { x: 0.20, y: 0.42, c: RED }, HUB_PRIME: { x: 0.50, y: 0.72, c: INK }, CATALYST_RING: { x: 0.78, y: 0.44, c: GRAY } };
    var hubs = GRAPH.hubs.map(function (h) {
      var m = hubMeta[h.id] || { x: 0.5, y: 0.5, c: GRAY };
      return { id: h.id, label: h.label, hub: true, color: m.c, count: h.count, fx: W * m.x, fy: H * m.y };
    });
    var nodes = GRAPH.nodes.map(function (n) {
      return {
        id: n.symbol, label: n.short, hub: false, hit: n.hit,
        color: (n.momentum === null ? GRAY : (n.momentum > 0 ? GREEN : RED)),
        parent: n.hub, r: n.hit ? 4.6 : 3.1
      };
    });
    var all = hubs.concat(nodes);
    var byId = new Map(all.map(function (n) { return [n.id, n]; }));
    var links = [];
    nodes.forEach(function (n) { if (byId.has(n.parent)) links.push({ source: n.id, target: n.parent, w: 1, spoke: true }); });
    var drawn = GRAPH.edges.slice().sort(function (a, b) { return Math.abs(b.rho) - Math.abs(a.rho); }).slice(0, 60);
    drawn.forEach(function (e) {
      if (byId.has(e.a) && byId.has(e.b)) links.push({ source: e.a, target: e.b, w: Math.abs(e.rho), spoke: false });
    });

    var sim = d3.forceSimulation(all)
      .force('link', d3.forceLink(links).id(function (d) { return d.id; })
        .distance(function (l) { return l.spoke ? 68 : 130; })
        .strength(function (l) { return l.spoke ? 0.95 : 0.02; }))
      .force('charge', d3.forceManyBody().strength(function (d) { return d.hub ? -900 : -58; }))
      .force('collide', d3.forceCollide(function (d) { return (d.hub ? 26 : d.r + 11); }))
      .force('x', d3.forceX(W / 2).strength(0.02))
      .force('y', d3.forceY(H / 2).strength(0.03))
      .alphaDecay(0.02)
      .stop();

    var svg = d3.select(el);
    var gLink = svg.append('g'), gPath = svg.append('g'), gNode = svg.append('g');

    var linkSel = gLink.selectAll('line').data(links).enter().append('line')
      .attr('stroke', function (d) { return d.spoke ? '#cfcbc0' : '#b9b5a9'; })
      .attr('stroke-width', function (d) { return d.spoke ? 0.6 : 0.5 + d.w; })
      .attr('stroke-opacity', function (d) { return d.spoke ? 0.7 : 0.35; });

    var nodeSel = gNode.selectAll('g').data(all).enter().append('g');
    nodeSel.append('circle')
      .attr('r', function (d) { return d.hub ? 9 + Math.min(13, Math.sqrt(d.count) * 3) : d.r; })
      .attr('fill', function (d) { return d.hub ? d.color : d.color; })
      .attr('opacity', function (d) { return d.hub ? 1 : 0.85; });
    var labelled = nodeSel;
    labelled.append('rect').attr('class', 'nl-bg').attr('height', 11).attr('rx', 1)
      .attr('fill', CARD).attr('fill-opacity', function (d) { return d.hub || d.hit ? 1 : 0.65; })
      .attr('stroke', function (d) { return d.hub ? INK : LINE; })
      .attr('stroke-opacity', function (d) { return d.hub || d.hit ? 1 : 0.5; }).attr('stroke-width', 0.6);
    labelled.append('text').attr('class', 'nl-tx')
      .attr('font-size', function (d) { return d.hub ? 8 : 6; })
      .attr('font-family', MONO)
      .attr('fill', function (d) { return d.hub || d.hit ? SOFT : FAINT; })
      .text(function (d) { return d.hub ? d.label : d.label; });

    var ticks = 0, t0 = performance.now(), running = true;
    function paint() {
      linkSel.attr('x1', function (d) { return d.source.x; }).attr('y1', function (d) { return d.source.y; })
        .attr('x2', function (d) { return d.target.x; }).attr('y2', function (d) { return d.target.y; });
      nodeSel.attr('transform', function (d) { return 'translate(' + d.x + ',' + d.y + ')'; });
      labelled.select('text.nl-tx')
        .attr('x', function (d) { return d.hub ? 0 : 7; })
        .attr('y', function (d) { return d.hub ? 3.5 : 3; })
        .attr('text-anchor', function (d) { return d.hub ? 'middle' : 'start'; });
      labelled.select('rect.nl-bg').each(function (d) {
        var tx = this.parentNode.querySelector('text.nl-tx');
        var w = 8;
        try { w = tx.getComputedTextLength() + 6; } catch (e) { w = d.label.length * 5 + 6; }
        d3.select(this)
          .attr('width', w)
          .attr('x', d.hub ? -w / 2 : 5)
          .attr('y', d.hub ? -5.5 : -5);
      });
      // median path through the hubs
      var hp = hubs.slice().sort(function (a, b) { return a.x - b.x; });
      if (hp.length === 3) {
        var d0 = 'M ' + hp[0].x + ' ' + hp[0].y +
          ' Q ' + ((hp[0].x + hp[1].x) / 2) + ' ' + (Math.min(hp[0].y, hp[1].y) - 60) + ' ' + hp[1].x + ' ' + hp[1].y +
          ' Q ' + ((hp[1].x + hp[2].x) / 2) + ' ' + (Math.min(hp[1].y, hp[2].y) - 60) + ' ' + hp[2].x + ' ' + hp[2].y;
        var p = gPath.selectAll('path.median').data([d0]);
        p.enter().append('path').attr('class', 'median').merge(p)
          .attr('d', function (d) { return d; })
          .attr('fill', 'none').attr('stroke', INK).attr('stroke-width', 2)
          .attr('stroke-dasharray', '7,5').attr('opacity', 0.75);
        var lx = hp[2].x + 26, ly = hp[2].y - 34;
        var g = gPath.selectAll('g.endlab').data([1]);
        var ge = g.enter().append('g').attr('class', 'endlab');
        ge.append('line'); ge.append('rect'); ge.append('text');
        var gm = gPath.select('g.endlab');
        gm.select('line').attr('x1', hp[2].x).attr('y1', hp[2].y).attr('x2', lx - 4).attr('y2', ly + 7)
          .attr('stroke', INK).attr('stroke-width', 1.2);
        gm.select('rect').attr('x', lx).attr('y', ly).attr('width', 62).attr('height', 15)
          .attr('fill', CARD).attr('stroke', INK).attr('stroke-width', 0.8);
        gm.select('text').attr('x', lx + 31).attr('y', ly + 10.5).attr('text-anchor', 'middle')
          .attr('font-size', 8).attr('font-family', MONO)
          .attr('fill', CFG.predicted === 'UP' ? GREEN : RED)
          .text((CFG.predicted === 'UP' ? '▲ ' : '▼ ') + (CFG.pUp || 0).toFixed(0) + '% UP');
      }
    }
    var counters = document.getElementById('graph-counters');
    var iterSec = document.getElementById('iter-sec');
    var convBar = document.getElementById('conv-bar'), convPct = document.getElementById('conv-pct');
    function step() {
      if (!running) return;
      for (var i = 0; i < 3; i++) { sim.tick(); ticks++; }
      paint();
      var a = sim.alpha(), progress = Math.min(1, Math.max(0, (1 - (a - 0.001) / 1)));
      if (convBar) convBar.style.width = (progress * 100).toFixed(0) + '%';
      if (convPct) convPct.textContent = (progress * 100).toFixed(0) + '%';
      if (counters) counters.textContent = 'nodes ' + all.length + ' · edges ' + GRAPH.edges.length +
        ' · signal ' + ((GRAPH.edges.length ? d3.mean(GRAPH.edges, function (e) { return Math.abs(e.rho); }) * 100 : 0)).toFixed(1) + '% · iter ' + ticks;
      var dt = (performance.now() - t0) / 1000;
      if (iterSec) iterSec.textContent = dt > 0 ? Math.round(ticks / dt).toLocaleString() : '—';
      if (a < 0.02 || ticks > 900) { running = false; if (convBar) convBar.style.width = '100%'; if (convPct) convPct.textContent = '100%'; return; }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  })();

  /* ------------------------------------------------------- 24h change hist */
  (function () {
    var c = document.getElementById('mini-hist');
    if (!c || !CHANGE.length) return;
    var min = Math.min.apply(null, CHANGE), max = Math.max.apply(null, CHANGE);
    var n = 12, range = (max - min) || 1, buckets = new Array(n).fill(0);
    CHANGE.forEach(function (v) { buckets[Math.min(n - 1, Math.floor(((v - min) / range) * n))]++; });
    var mx = Math.max.apply(null, buckets) || 1;
    c.innerHTML = buckets.map(function (k, i) {
      var mid = min + ((i + 0.5) / n) * range;
      return '<div class="bar ' + (mid >= 0 ? 'pos' : 'neg') + '" style="height:' + Math.max(2, (k / mx) * 54) + 'px" title="' + mid.toFixed(1) + '% · ' + k + '"></div>';
    }).join('');
  })();
})();
